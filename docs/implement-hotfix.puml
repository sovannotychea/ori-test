
@startuml
title implement hotfix (kanban) Workflow
skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
  StartColor #239B56
  EndColor #C0392B
}
start
:hotfix activate all dev repick base on prioritize and FIFO;
:producing test;
:implement;
:Create PR;
:producing document and release sop;
:Merge to stage;
:stage and regression testing (QA));
while (Tests passed?) is (No)
    partition "Reopen" {
      :Move ticket to reopen (QA);
      :refix and move ticket back to ready to test (dev);
    }
    :Retest;
endwhile (Yes)
:Merge to stage;
stop
@enduml