@startuml
title Intake Workflow

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
  StartColor #239B56
  EndColor #C0392B
}
start
fork
  :INPUT 1 - PO or PMO Projects;
  :New products, major enhancements,\nregulatory-driven changes;
  :Review requirements, business impact,\nestimation and priority;
  :Dev input, Technical debt, SLA;
  :Assess severity;
  :Activate implement Workflow (scrum);
fork again
  :INPUT 2 - IT Support;
  :Production incidents and defects;
  :Review requirements, business impact,\nestimation and priority;
  :Dev input, Technical debt, SLA;
  :Assess severity;
  if (risk heatmap\nCritical production incident?) then (Yes)
    :Activate implement Workflow emergency hotfix (kanban);
  else (No)
    :Add defect to backlog (kanban);
  endif
end fork
stop
@enduml