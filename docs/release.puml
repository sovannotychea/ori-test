@startuml
title System Architecture

skinparam componentStyle rectangle
skinparam shadowing true

actor User

package "Presentation Layer" {
    [Web Application] as Web
    [Mobile Application] as Mobile
}
package "security and availability Layer" {
    [cloudflare] as cloudflare
    [load balanced] as loadbalanced
}

package "Application Layer" {
    [API Gateway] as Gateway
    [Authentication Service] as Auth
    [Business 1 Services] as Services1
    [Business 2 Services] as Services2
}

package "Data Layer" {
    database "PostgreSQL" as DB
    database "Redis Cache" as Redis
}

package "External Systems" {
    [Notification Service] as Notify
    [Third-party APIs] as External
}

User --> Web
User --> Mobile

Web --> cloudflare : HTTPS / REST
Mobile --> cloudflare : HTTPS / REST
cloudflare --> loadbalanced : HTTPS / REST
loadbalanced --> Gateway : HTTPS / REST
Gateway --> Auth : Authenticate
Gateway --> Services1 : Route requests
Gateway --> Services2 : Route requests
Gateway --> Notify : Route requests
Gateway --> External : Route requests
Auth --> DB : Read / Write
Auth --> Redis : Read / Write
Services1 --> DB : Read / Write
Services2 --> DB : Read / Write
Services1 --> Redis : Cache operations
Services2 --> Redis : Cache operations
Services1 --> Gateway : Send notifications
Services2 --> Gateway : API integration
Notify --> Redis : Cache operations
External --> Redis : Cache operations
Notify --> DB : Read / Write
External --> DB : Read / Write

@enduml