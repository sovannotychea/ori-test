@startuml
title QA Release Workflow

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
  StartColor #239B56
  EndColor #C0392B
}
start
:Qualify Release;
while (smoke Tests passed?) is (No)
if (timely releases?) then (No)
  :Return defects to development;
           partition "QA Team" {
               :Move ticket defects (QA)
               :finding defects details;
           }
           partition "Development Team" {
           :Implement Workflow ;
           }
           :Retest;
else (No)
  :rollback;
  stop
endif
endwhile (Yes)
:Ready to Release;
stop
@enduml