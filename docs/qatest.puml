@startuml
title QA Test Workflow

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
  StartColor #239B56
  EndColor #C0392B
}
start
:stage and regression testing;
:UAT validation where applicable;
while (Tests passed?) is (No)
    :Return defects to development;
    partition "Development Team" {
      :Move ticket to reopen (QA) and refix and move ticket back to ready to test (dev);
    }
    :Retest;
endwhile (Yes)
:smoke tests (covers only the core functionalities PVT);
while (smoke Tests passed?) is (No)
    :Return defects to development;
    partition "Development Team" {
      :Move ticket defects (QA) and refix run unit tests (dev);
    }
    :Retest;
endwhile (Yes)
:Ready to Release;
stop
@enduml