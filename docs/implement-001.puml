
@startuml
title implement (kanban and scrum) Workflow
skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
  StartColor #239B56
  EndColor #C0392B
}
start
:pick the most prioritize backlog ;
:producing test;
:implement;
:Create PR;
:producing document and release sop;
:Merge to stage;
while (Tests passed?) is (No)
    partition "Reopen" {
      :Move ticket to reopen (QA);
      :pick up and refix (Dev);
      :Create PR;
      :update document and release sop;
      :Merge to stage;
      :stage and regression testing (QA);
    }
    :Retest;
endwhile (Yes)
:Qualify Release;
stop
@enduml